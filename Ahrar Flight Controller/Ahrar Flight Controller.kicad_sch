	(lib_symbols)
	(text "Add the following connections:\n- Analog; voltage and current measurements like the \nPixhawk power module -> ADC channel\n- additional computer that processes images -> \nUART (Jetson nano, Raspberry pi\n- reciever for control -> FrSky X8R Receiver \n- Pitot Tube -> I2C (Pixhawk sensor).\n- Buzzer -> PWM (On the board)\n----------------------\nconsider the following with Ethernet:\n- Tranciever to transmit images\n- Lidar "
		(exclude_from_sim no)
		(at 297.942 24.892 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
			(justify left)
		)
		(uuid "859047e1-b9a7-4ea9-9a2d-55dbc8b283bd")
	)
	(text "Check footprint for all of the components"
